html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Update Email Address Request
    body 
        h1 Hello #{name}! 
        p You are receiving this email because we received an update email request for your account.
        p
            strong=token 

        p This OTP will expire in #{expireTime}

        p If you did not intiated this action, no further action is required.<br><br>
        
        p Regards,<br>
        span=appName